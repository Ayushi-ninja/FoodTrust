            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestamp\": \"{{$isoTimestamp}}\",\n  \"firmwareVersion\": \"1.0.4\",\n  \"batteryPct\": 95\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/iot/heartbeat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "iot", "heartbeat"]
            }
          }
        },
