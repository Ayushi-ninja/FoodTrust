          "name": "Ingest Sensor Telemetry",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-bin-id", "value": "{{binCode}}" },
              { "key": "x-device-token", "value": "{{deviceToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"binCode\": \"{{binCode}}\",\n  \"timestamp\": \"{{$isoTimestamp}}\",\n  \"ambient\": {\n    \"temperatureC\": 4.2,\n    \"humidityPct\": 65.0,\n    \"vocGasPpm\": 45.0\n  },\n  \"system\": {\n    \"lidOpen\": false,\n    \"batteryPct\": 95,\n    \"firmwareVersion\": \"1.0.4\"\n  },\n  \"trays\": [\n    {\n      \"trayNumber\": 1,\n      \"category\": \"COOKED_MEALS\",\n      \"rawWeightKg\": 12.5,\n      \"tareWeightKg\": 2.5,\n      \"netWeightKg\": 10.0\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/iot/telemetry",
              "host": ["{{baseUrl}}"],
              "path": ["api", "iot", "telemetry"]
            }
          }
        },
